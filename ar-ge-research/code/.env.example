# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/drakesterling_ebay_arge?schema=public"

# eBay API Configuration (Sandbox)
EBAY_CLIENT_ID_SANDBOX=your_sandbox_client_id
EBAY_CLIENT_SECRET_SANDBOX=your_sandbox_client_secret
EBAY_RU_NAME_SANDBOX=your_sandbox_ru_name
EBAY_SANDBOX_BASE_URL=https://api.sandbox.ebay.com
EBAY_SANDBOX_AUTH_URL=https://auth.sandbox.ebay.com

# eBay API Configuration (Production)
EBAY_CLIENT_ID_PRODUCTION=your_production_client_id
EBAY_CLIENT_SECRET_PRODUCTION=your_production_client_secret
EBAY_RU_NAME_PRODUCTION=your_production_ru_name
EBAY_PRODUCTION_BASE_URL=https://api.ebay.com
EBAY_PRODUCTION_AUTH_URL=https://auth.ebay.com

# JWT Configuration (optional, for user sessions)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Cron Jobs
ORDER_SYNC_INTERVAL=15
PRODUCT_SYNC_INTERVAL=30

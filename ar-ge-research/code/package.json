        "axios": "^1.6.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.0",
        "express": "^4.18.0",
        "express-rate-limit": "^7.1.0",
        "helmet": "^7.1.0",
        "morgan": "^1.10.0",
        "node-cron": "^3.0.0",
        "uuid": "^9.0.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.19.21",
        "@types/node-cron": "^3.0.11",
        "@types/uuid": "^9.0.7",
        "@typescript-eslint/eslint-plugin": "^6.13.0",
        "@typescript-eslint/parser": "^6.13.0",
        "eslint": "^8.54.0",
        "nodemon": "^3.1.10",
        "prisma": "^5.7.0",
        "ts-node": "^10.9.1",
        "typescript": "^5.3.0"
    },
    "prisma": {

{
    "name": "ebay-integration-example",
    "version": "1.0.0",
    "type": "module",
    "description": "eBay API Integration Example with Express, Prisma, and OAuth",
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon --exec ts-node-esm src/server.ts",
